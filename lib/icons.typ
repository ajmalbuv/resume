// --- Renderer (single source of truth) ---
#let icon(name, size: 10pt, baseline: 1.5pt, color: black) = {
  let path = _icons.at(name)
  let fill-hex = if type(color) == str { color } else { color.to-hex() }

  box(
    image(
      bytes(
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='" + fill-hex + "'>" + path + "</svg>",
      ),
      width: size,
    ),
    baseline: baseline,
  )
}
